# ---------------------------------------------------------------------------
# Firebase / Firestore service account (server-side only — never exposed to the
# browser). Create a service account in the Firebase console:
#   Project settings → Service accounts → Generate new private key
# then copy the three values from the downloaded JSON.
#
# Locally: copy this file to `.env.local` and fill it in.
# On Vercel: add these under Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Paste the whole private key. Keep the literal \n escapes on one line, e.g.
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII…\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: which Firestore document holds this session's state — scores,
# used questions, current round/question, host lock, live projector doc.
# Defaults to "mar-thoma-quiz-2026" if unset (same as production).
#
# The question bank itself (rounds/questions) always lives under the fixed
# "mar-thoma-quiz-2026" document regardless of this setting — it's shared
# across every session, since there's only one quiz's worth of questions.
#
# Set both of these to the SAME value (they must match) to give local dev
# its own isolated session — separate scores/progress/host-lock — that runs
# alongside the real event on Vercel without conflicting with it:
# QUIZ_GAME_ID=dev-test
# NEXT_PUBLIC_QUIZ_GAME_ID=dev-test

# Optional: require this code (sent by the host's browser) before the server
# will save. Leave unset to allow saves from anyone with the URL.
# HOST_ACCESS_CODE=changeme
